{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "BUILD_TESTING": true,
        "EMBARCADERO_NATIVE_ARCH": false,
        "EMBARCADERO_SANITIZER": "none",
        "EMBARCADERO_ENABLE_UNSAFE_LEGACY_E2E": false
      }
    },
    {
      "name": "release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "BUILD_TESTING": true,
        "EMBARCADERO_NATIVE_ARCH": false,
        "EMBARCADERO_SANITIZER": "none",
        "EMBARCADERO_ENABLE_UNSAFE_LEGACY_E2E": false
      }
    },
    {
      "name": "asan-ubsan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/asan-ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "BUILD_TESTING": true,
        "EMBARCADERO_NATIVE_ARCH": false,
        "EMBARCADERO_SANITIZER": "address-undefined",
        "EMBARCADERO_ENABLE_UNSAFE_LEGACY_E2E": false
      }
    },
    {
      "name": "tsan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "BUILD_TESTING": true,
        "EMBARCADERO_NATIVE_ARCH": false,
        "EMBARCADERO_SANITIZER": "thread",
        "EMBARCADERO_ENABLE_UNSAFE_LEGACY_E2E": false
      }
    },
    {
      "name": "release-native",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/release-native",
      "cacheVariables": {
        "EMBARCADERO_NATIVE_ARCH": true
      }
    },
    {
      "name": "client-minimal",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/client-minimal",
      "cacheVariables": {
        "BUILD_TESTING": false,
        "EMBARCADERO_BUILD_BROKER": false,
        "EMBARCADERO_BUILD_BASELINE_TOOLS": false,
        "EMBARCADERO_CLIENT_BASELINES": false,
        "EMBARCADERO_BUILD_BENCHMARKS": false
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "release-native",
      "configurePreset": "release-native"
    },
    {
      "name": "client-minimal",
      "configurePreset": "client-minimal",
      "targets": [
        "throughput_test"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release-native",
      "configurePreset": "release-native",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
